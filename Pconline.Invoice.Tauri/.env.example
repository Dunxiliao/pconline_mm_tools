# 对应 Pconline.Invoice App.Debug.config 迁移到 .env
# 复制为 .env 并填写实际值

# ---------- connectionStrings（与 App.Debug.config 一一对应）----------
# db：发票库，必填；SearchPath=datas 通过 options 传递
# INVOICE_DB_URL=postgres://user:password@host:5432/dbname?options=-c%20search_path%3Ddatas
# Debug 示例：INVOICE_DB_URL=postgres://odoo:admin123@127.0.0.1:5439/shipping_invoice?options=-c%20search_path%3Ddatas

# odooDb：Odoo/订单库（Pull Database、Assign Order 等）
# ODOO_DB_URL=postgres://user:password@host:5432/dbname
# 密码含特殊字符时需 URL 编码： ( %28 ) %29 @ %40 # %23 & %26

# efShipDb：EtailFlow 出运库
# EFSHIP_DB_URL=postgres://user:password@host:port/EtailFlow

# wmsDb：WMS 库（Payment 上传：etailflow_client_accounts, sale_order, sale_order_package）
# WMS_DB_URL=postgres://user:password@host:port/wmsdb

# ---------- appSettings ----------
# postUrl：Etailflow API，默认 https://order.innovberg.com；Debug 用 ETAILFLOW_URL=http://localhost:5000/
# ETAILFLOW_URL=

# merchantCode：Tracking 回传商户码，默认 pconline
# ETAILFLOW_MERCHANT_CODE=pconline

# version：应用版本展示（可选）
# APP_VERSION=Version 2.1.6 (Debug)
